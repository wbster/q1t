{
	"name": "q1t",
	"version": "1.5.0",
	"description": "",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"files": ["dist"],
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"clean": "rm -rf dist",
		"test": "vitest run .",
		"typecheck": "tsc --noEmit",
		"lint": "biome check ./src",
		"build": "npm run clean && vite build",
		"prepublishOnly": "npm run build",
		"version": "npm test",
		"preversion": "npm run build",
		"docs": "typedoc",
		"format": "biome format --write ./src",
		"prepare": "husky"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/wbster/q1t.git"
	},
	"homepage": "https://github.com/wbster/q1t#readme",
	"bugs": {
		"url": "https://github.com/wbster/q1t/issues"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/wbster"
	},
	"keywords": [
		"state",
		"reactive",
		"observable",
		"observer",
		"typescript",
		"webworker",
		"worker",
		"react"
	],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@biomejs/biome": "1.8.2",
		"@types/node": "^26.1.1",
		"@types/react": "^18.3.3",
		"@typescript/lib-dom": "npm:@types/web@^0.0.149",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"typedoc": "^0.26.1",
		"typescript": "5.4",
		"vite": "^5.3.1",
		"vite-plugin-dts": "^3.9.1",
		"vitest": "^1.6.0"
	},
	"peerDependencies": {
		"react": "^18.3.1 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,jsonc}": ["biome check --write"]
	}
}
